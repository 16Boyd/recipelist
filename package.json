{
  "name": "recipelist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "admin:promote": "node dist-server/server/promote-admin.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-auth": "^1.7.11",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "kysely": "^0.28.18",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
